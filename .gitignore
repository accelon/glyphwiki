# 由 dump 產生的資料庫（可重建，不入版控）
db/
*.db
*.db-wal
*.db-shm
*.db-journal

# bun
node_modules/
bun.lockb

# CodeMirror 6 的下載與打包產物（可重建，不入版控）
#   cd vendor-cm && npm install && cd .. && bun run vendor-cm/build.ts
vendor-cm/node_modules/
vendor-cm/dist/
vendor-cm/package-lock.json

# 匯出檔
out/

# 原始資料與第三方資料（體積大、可另行下載；不入版控）
#   dump/ 291 MB、db/ 1.7 GB、unihan/ 40 MB、unicode-cjk-ids/ 4.3 MB、
#   dump.tar.gz 109 MB、swjz.xml 5.9 MB、vendor-cm/ 3 MB（cd vendor-cm && npm install 可重建）
#   `ids/`（7.6 MB，IDS 來源）**有進版控** —— 建置要用它
dump/
dump.tar.gz
unihan/
unicode-cjk-ids/
gokage/
swjz.xml
vendor-cm/
nul

# 內嵌的 git 倉庫（各自的 clone）——直接 `git add` 只會存一個**指標** ✗，
# 對外 clone 拿不到內容 ✗，所以不入版控；要用的話自行 clone：
#   git clone https://github.com/yi-bai/ids            ids
#   kage-engine／unicode-cjk-ids 亦同（見 progress/技術交接文件.md §15.7）
ids/
kage-engine/
unicode-cjk-ids/

# gocore（Go 模組）的產物——全部可重建，不入版控
#   .cache/    Go 的 build cache（DSH 沙箱下 GOCACHE 必須重導進工作區，見 gocore/README.md）
#   _gen/      `tools/lib-format.ts` 的暫存複本（沙箱下 bun 的模組載入器讀不到 tools/，見 refdump.ts）
#   testdata/  差分測試的 golden 檔與字庫複本（由 `bun run gocore/refdump.ts` 產生）
gocore/.cache/
gocore/_gen/
gocore/testdata/

# pinxing-app（Wails3 殼）的產物——全部可重建，不入版控
#   .cache/                           Go 的 build cache（沙箱下必須重導進工作區）
#   *.exe                             編譯產物
#   *.syso                            Windows 資源物件（manifest＋版本資源＋圖示，由 wails3 generate syso 產生）
#   *.log                             啟動日誌（執行時寫在 exe 旁邊）
#   internal/glyphdata/*.bin.gz       `out/` 字庫的複本（go:embed 只能嵌模組目錄內的檔案）
#   go.sum **要**進版控（相依鎖定）
#   build/appicon.png、build/windows/icon.ico **要**進版控（是來源資產，不是產物）
pinxing-app/.cache/
pinxing-app/*.exe
pinxing-app/*.syso
pinxing-app/*.log
pinxing-app/internal/glyphdata/*.bin.gz
# 前端是**產生出來的**：`bun run tools/build-pinxing.ts --hosted`（build.ps1 會跑）。
# 頁面程式碼的唯一來源是 tools/pinxing-page.js 與它內嵌的模組——
# 這樣才不會出現兩份各說各話的頁面。
pinxing-app/frontend/index.html
# WebView2 的 user data folder（保底放在 exe 旁邊，見 internal/wvdata）——
# 它是執行時的設定檔快取，不入版控
pinxing-app/pinxing-app.webview2/
